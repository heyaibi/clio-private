hpad when key is omitted.","inputSchema":{"additionalProperties":false,"properties":{"actor":{"description":"Attribution actor.","enum":["agent","harness","user","system"],"type":"string"},"bank":{"description":"Isolation key; overrides the connection default when present.","type":"string"},"key":{"description":"Scratchpad key.","type":"string"},"session":{"description":"Session scope (defaults to the connection session).","type":"string"}},"required":[],"type":"object"},"name":"scratchpad_clear","tool":"scratchpad_clear"},{"description":"Single-slot upsert: closes the prior value on both time axes and inserts the admitted revision.","inputSchema":{"additionalProperties":false,"properties":{"actor":{"description":"Attribution actor.","enum":["agent","harness","user","system"],"type":"string"},"bank":{"description":"Isolation key; overrides the connection default when present.","type":"string"},"category":{"description":"Semantic category of the slot value.","enum":["task_spec","schema","tool_config","output_constraint","persona"],"type":"string"},"confidence":{"description":"Optional confidence in 0.0..=1.0.","type":"number"},"context":{"description":"Optional bounded descriptive source context (at most 4096 UTF-8 bytes; rejected when empty or oversized, never truncated).","maxLength":4096,"type":"string"},"dry_run":{"description":"Score and validate without writing.","type":"boolean"},"epistemic_kind":{"description":"Fact or belief.","enum":["fact","belief"],"type":"string"},"item":{"additionalProperties":false,"description":"Optional shell carrying a caller item id.","properties":{"id":{"description":"Caller item id; generated when omitted.","type":"string"}},"type":"object"},"key":{"description":"Canonical slot key (e.g. primary_database_host).","type":"string"},"snapshot":{"description":"Optional authoritative structured snapshot (verified against source_text).","type":"object"},"source_type":{"description":"Provenance source type.","enum":["user_stated","agent_